# Deploy target for `npm run deploy`. Copy this file to `deploy.env`
# (git-ignored) and fill in your values.

# SSH target that can write REMOTE_DIR. Any host/alias your ~/.ssh/config knows;
# a bastion/ProxyJump is handled there, not here. Example: my-docker-host
REMOTE=

# Absolute path on REMOTE that serves the built SPA — e.g. a directory
# bind-mounted read-only into your reverse-proxy container.
REMOTE_DIR=/opt/apps/comics/dist

# Optional: host-local port where the deployed app answers. Used for a
# post-deploy health check (served bundle matches the build + /komga proxy
# returns 200). Leave empty to skip the health check.
HEALTHCHECK_PORT=

# Optional: printed on success.
PUBLIC_URL=
